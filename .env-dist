#
# Ci-dessous les variables pour configurer les conteneurs de ia rameau
# Marche à suivre:
#   il faut copier ce fichier dans un fichier .env
#   avant de démarrer l'application avec docker-compose up
#

######################################################
# Caping for containers
######################################################
MEM_LIMIT=8g
CPU_LIMIT=8
# Accélération GPU pour les conteneurs Docker (true si GPU NVIDIA + drivers WSL configurés, sinon false)
ENABLE_GPU=false

######################################################
# Paramétrage version
######################################################
INDEXATION_SUJET_API_VERSION=test-api
INDEXATION_SUJET_VECTORISATION_VERSION=test-vectorisation
INDEXATION_SUJET_QDRANT_VERSION=v1.19.1

######################################################
# Paramétrage de indexation-sujet-api
######################################################
INDEXATION_SUJET_API_HTTP_PORT=8071
INDEXATION_SUJET_API_HTTP_HOST=0.0.0.0
INDEXATION_SUJET_CORS_ORIGINS=*

######################################################
# Paramétrage de indexation-sujet-qdrant
######################################################
INDEXATION_SUJET_QDRANT_HOST=indexation-sujet-qdrant
INDEXATION_SUJET_QDRANT_PORT=6333
INDEXATION_SUJET_QDRANT_TEST_LIMIT=6
# Seuil minimal de vecteurs pour autoriser l'écrasement dans Qdrant (1000 en prod, baisser pour les petits CSV de test)
INDEXATION_SUJET_QDRANT_MIN_VECTORS=10

######################################################
# Paramétrage de indexation-sujet-vectorisation
######################################################
INDEXATION_SUJET_VECTORISATION_HOST=0.0.0.0
INDEXATION_SUJET_VECTORISATION_PORT=8100
# INDEXATION_SUJET_CSV_INIT_FILENAME=
# INDEXATION_SUJET_CSV_UPDATE_FILENAME=

INDEXATION_SUJET_DOCKER_NETWORK=indexation-sujet-network
INDEXATION_SUJET_DOCKER_IMAGE_BATCH=abesesr/indexation-sujet:${INDEXATION_SUJET_VECTORISATION_VERSION}
INDEXATION_SUJET_DOCKER_SOCK=unix:///var/run/docker.sock
INDEXATION_SUJET_DOCKER_BATCH_USER=root

INDEXATION_SUJET_VECTORIZE_CONCEPTS_OR_CHAINS=concepts
INDEXATION_SUJET_VECTORIZE_AVEC_THESE=only_mono


######################################################
# Paramétrage de indexation-sujet-volume
######################################################
INDEXATION_SUJET_DOCKER_VOLUME_BIND=./volumes

######################################################
# Paramétrage de indexation-sujet-llm
######################################################
INDEXATION_SUJET_LLM_PORT=11434
INDEXATION_SUJET_LLM_URL=http://ollama:${INDEXATION_SUJET_LLM_PORT}/v1
INDEXATION_SUJET_LLM_KEY=
INDEXATION_SUJET_LLM_MODEL=llama3.1:8b
